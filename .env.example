# Discord bot token from the developer portal
DISCORD_TOKEN=

# optional overrides, defaults are fine for most setups
DB_PATH=db/musicbot.sqlite3
MAX_QUEUE_SIZE=0
SPOTIFY_MATCH_SEARCH_DEPTH=5

# how often (seconds) the now-playing embed's progress bar refreshes
# while something is actively playing. Lower is more "live" but sends
# more message edits, higher is gentler on the host and on Discord's
# rate limits.
NOWPLAYING_UPDATE_INTERVAL_SECONDS=15

# discord user ids that skip the playback vote, comma separated.
# example: VOTE_BYPASS_USER_IDS=111111111111111111,222222222222222222
VOTE_BYPASS_USER_IDS=

# logging verbosity. INFO is the default and is fine for normal use.
# set to DEBUG when chasing something intermittent (stream url 403s,
# the "already in a channel" issue), it turns on things like ffmpeg
# stderr passthrough and per-track stream url expiry diagnostics.
MUSICBOT_LOG_LEVEL=INFO
